<div class="chat">
  <%= link_to "← #{@chat.plant.nickname}", plant_path(@chat.plant), class: "chat-back" %>

  <h1 id="chat_title" class="chat-title"><%= @chat.display_title %></h1>

  <div id="messages">
    <%= render "messages/messages", messages: @chat.messages %>
  </div>

  <div id="new_message_container">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>
</div>
