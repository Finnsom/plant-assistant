<div class="auth">
  <div class="auth__panel">
    <h1 class="auth__title">Start with Leafy</h1>
    <p class="auth__subtitle">Add your plants and find out what they need.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth__form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth__field">
        <%= f.label :email, class: "auth__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth__input" %>
      </div>

      <div class="auth__field">
        <%= f.label :password, class: "auth__label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "auth__input" %>
        <p class="auth__hint">At least <%= @minimum_password_length %> characters.</p>
      </div>

      <div class="auth__field">
        <%= f.label :password_confirmation, "Confirm password", class: "auth__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth__input" %>
      </div>

      <%= f.submit "Create account", class: "btn btn-leafy auth__submit" %>
    <% end %>

    <p class="auth__alt">
      Already have an account? <%= link_to "Log in", new_session_path(resource_name) %>
    </p>
  </div>
</div>
