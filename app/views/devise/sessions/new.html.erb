<div class="auth">
  <div class="auth__panel">
    <h1 class="auth__title">Welcome back</h1>
    <p class="auth__subtitle">Log in to check on your plants.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth__form" }) do |f| %>
      <div class="auth__field">
        <%= f.label :email, class: "auth__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth__input" %>
      </div>

      <div class="auth__field">
        <%= f.label :password, class: "auth__label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "auth__input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="auth__remember">
          <%= f.check_box :remember_me %>
          <span>Keep me logged in</span>
        </label>
      <% end %>

      <%= f.submit "Log in", class: "btn btn-leafy auth__submit" %>
    <% end %>

    <p class="auth__alt">
      New here? <%= link_to "Create an account", new_registration_path(resource_name) %>
    </p>
    <p class="auth__alt auth__alt--quiet">
      <%= link_to "Forgot your password?", new_password_path(resource_name) %>
    </p>
  </div>
</div>
