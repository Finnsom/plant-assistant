<% if message.role == "user" %>
  <div class="message-user">
    <div class="message-user__bubble">
      <% if message.image.attached? %>
        <%= image_tag message.image, class: "message-user__image", alt: "Uploaded plant photo" %>
      <% end %>
      <%= raw(render_markdown(message.content)) if message.content.present? %>
    </div>
  </div>
<% elsif message.role == "assistant" %>
  <div class="message-assistant" id="<%= dom_id(message) %>">
    <%= message.content.present? ? raw(render_markdown(message.content)) : "…" %>
  </div>
<% end %>
