<% if message.role == "user" %>
  <div class="message-user">
    <div class="message-user__bubble">
      <%= raw(render_markdown(message.content)) %>
    </div>
  </div>
<% elsif message.role == "assistant" %>
  <div class="message-assistant">
    <%= raw(render_markdown(message.content)) %>
  </div>
<% end %>
