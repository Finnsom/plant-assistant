<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Plants</h1>
    <%= link_to "Add a Plant", new_plant_path, class: "btn btn-success" %>
  </div>

  <% if @plants.any? %>
    <div class="row">
      <% @plants.each do |plant| %>
        <div class="col-md-4 mb-3">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title"><%= plant.nickname %></h5>
              <p class="card-text text-muted"><%= plant.species %></p>
              <p class="card-text"><i class="fas fa-map-marker-alt"></i> <%= plant.location %></p>
              <p class="card-text"><i class="fas fa-tint"></i> Last watered: <%= plant.last_watered_on&.strftime("%B %d, %Y") || "Never" %></p>
              <%= link_to "View Details", plant_path(plant), class: "btn btn-primary" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>You don't have any plants yet. Add your first one!</p>
  <% end %>
</div>
