<div class="plants">
  <div class="plants-header">
    <h1 class="plants-title">My plants</h1>
    <%= link_to "Add a plant", new_plant_path, class: "btn btn-leafy" %>
  </div>

  <% if @plants.any? %>
    <div class="plant-grid">
      <% @plants.each do |plant| %>
        <div class="plant-card">
          <%= link_to plant_path(plant), class: "plant-card__link" do %>
            <div class="plant-card__media">
              <% if plant.photo.attached? %>
                <%= image_tag plant.photo, class: "plant-card__photo", alt: plant.nickname %>
              <% else %>
                <div class="plant-card__placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                  </svg>
                </div>
              <% end %>
            </div>

            <div class="plant-card__body">
              <h2 class="plant-card__name"><%= plant.nickname %></h2>
              <p class="plant-card__species"><%= plant.species %></p>

              <dl class="plant-card__meta">
                <div class="plant-card__meta-row">
                  <dt>Where</dt>
                  <dd><%= plant.location.presence || "Not set" %></dd>
                </div>
                <div class="plant-card__meta-row">
                  <dt>Water</dt>
                  <dd class="<%= "is-overdue" if watering_overdue?(plant) %>">
                    <%= watering_status(plant) %>
                  </dd>
                </div>
              </dl>
            </div>
          <% end %>

          <div class="plant-card__action">
            <%= button_to "Watered today", watered_today_plant_path(plant), method: :patch, class: "btn btn-leafy-quiet" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="plants-empty">
      <h2>No plants yet</h2>
      <p>Add your first plant and Leafy can start helping you look after it.</p>
      <%= link_to "Add a plant", new_plant_path, class: "btn btn-leafy" %>
    </div>
  <% end %>
</div>
