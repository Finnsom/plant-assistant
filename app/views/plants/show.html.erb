<div class="plant-show">
  <%= link_to "← My plants", plants_path, class: "plant-show__back" %>

  <div class="plant-show__layout">
    <div class="plant-show__media">
      <% if @plant.photo.attached? %>
        <%= image_tag @plant.photo, class: "plant-show__photo", alt: @plant.nickname %>
      <% else %>
        <div class="plant-show__placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
          </svg>
        </div>
      <% end %>
    </div>

    <div class="plant-show__detail">
      <h1 class="plant-show__name"><%= @plant.nickname %></h1>
      <p class="plant-show__species"><%= @plant.species %></p>

      <dl class="plant-show__meta">
        <div class="plant-show__meta-row">
          <dt>Where</dt>
          <dd><%= @plant.location.presence || "Not set" %></dd>
        </div>
        <div class="plant-show__meta-row">
          <dt>Water</dt>
          <dd class="<%= "is-overdue" if watering_overdue?(@plant) %>">
            <%= watering_status(@plant) %>
          </dd>
        </div>
      </dl>

      <%= button_to "Ask about this plant", plant_chats_path(@plant), method: :post, class: "btn btn-leafy plant-show__ask" %>

      <div class="plant-show__secondary">
        <%= button_to "Watered today", watered_today_plant_path(@plant), method: :patch, class: "btn btn-leafy-quiet" %>
        <%= link_to "Edit", edit_plant_path(@plant), class: "btn btn-leafy-quiet" %>
        <%= button_to "Delete", plant_path(@plant), method: :delete, class: "btn btn-leafy-danger", data: { turbo_confirm: "Delete #{@plant.nickname}? This can't be undone." } %>
      </div>
    </div>
  </div>
</div>
